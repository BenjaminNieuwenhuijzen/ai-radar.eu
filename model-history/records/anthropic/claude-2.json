  "summary": {
    "text": "Claude 2 is the successor to Anthropic's Claude language model, released in July 2023 through the API and claude.ai, a new public beta chat site open to users in the US and UK. It accepted prompts of up to 100K tokens, and Anthropic's model card describes it as an evolution of its earlier Claude models rather than a major change. It was later also offered on Amazon Bedrock.",
    "sources": [
      {
        "id": "src.anthropic.claude-2-announcement"
      },
      {
        "id": "src.anthropic.claude-2-model-card",
        "locator": "section 2, Claude 2 Model Card"
      },
      {
