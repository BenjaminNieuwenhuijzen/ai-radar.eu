  "summary": {
    "text": "The October 2024 revision of Claude 3.5 Sonnet is an upgraded version of that Anthropic language model for text and image input, released under the same name but with its own API id, claude-3-5-sonnet-20241022. It introduced computer use as a public beta on the Anthropic API, Amazon Bedrock and Google Cloud Vertex AI, and Anthropic says it kept the price and speed of the June 2024 model.",
    "sources": [
      {
        "id": "src.anthropic.3-5-models-and-computer-use-announcement"
      },
      {
        "id": "src.anthropic.model-deprecations"
      },
      {
        "id": "src.anthropic.api-release-notes"
      }
    ]
  },
  "changes": [
    {
      "id": "computer-use",
      "aspect": "tool-use",
      "direction": "added",
      "relativeTo": "anthropic.claude-3-5-sonnet",
      "text": "Adds computer use in public beta: the model works with a computer by looking at a screen, moving a cursor, clicking and typing. Anthropic called the feature experimental.",
