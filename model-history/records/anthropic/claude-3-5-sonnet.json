  "summary": {
    "text": "Claude 3.5 Sonnet is a language model from Anthropic that accepts text and images, the first release of its Claude 3.5 family. It was free on claude.ai and the Claude iOS app and offered through the Anthropic API, Amazon Bedrock and Google Cloud Vertex AI; Anthropic says it kept the speed and cost of Claude 3 Sonnet and ran at twice the speed of Claude 3 Opus.",
    "sources": [
      {
        "id": "src.anthropic.claude-3-5-sonnet-announcement"
      },
      {
        "id": "src.anthropic.api-release-notes"
      }
    ]
  },
