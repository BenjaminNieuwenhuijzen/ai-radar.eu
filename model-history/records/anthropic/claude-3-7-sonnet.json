  "summary": {
    "text": "Claude 3.7 Sonnet is a language model in Anthropic's Sonnet line that accepts text and images and was offered in the Claude apps, on the Anthropic API, Amazon Bedrock and Google Cloud Vertex AI. Anthropic calls it a hybrid reasoning model: it gives standard answers or, in an extended thinking mode, shows its reasoning step by step.",
    "sources": [
      {
        "id": "src.anthropic.claude-3-7-sonnet-announcement"
      },
      {
        "id": "src.anthropic.transparency-hub-model-report",
        "locator": "Claude 3.7 Sonnet Summary Table, Modalities"
      }
    ]
  },
