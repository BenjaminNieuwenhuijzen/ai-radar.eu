  "summary": {
    "text": "Claude 3 Sonnet is the middle model of Anthropic's Claude 3 family: a language model that accepts text and images, responds in text and, according to Anthropic, balances intelligence and speed for enterprise workloads. At launch it powered the free tier of claude.ai and was offered through the Claude API and Amazon Bedrock, with a private preview on Google Cloud Vertex AI.",
    "sources": [
      {
        "id": "src.anthropic.claude-3-family-announcement"
      },
      {
        "id": "src.anthropic.claude-3-model-card"
      }
    ]
  },
  "changes": [
    {
      "id": "image-input",
      "aspect": "modality",
      "direction": "added",
      "text": "Adds image input next to text, which the Claude 3 model card names as a key enhancement of the family; output remains text.",
      "sources": [
        {
          "id": "src.anthropic.claude-3-model-card"
        }
      ]
    },
    {
      "id": "speed",
      "aspect": "efficiency",
      "direction": "changed",
      "text": "Anthropic says it is about twice as fast as Claude 2 and Claude 2.1 for most workloads.",
      "sources": [
        {
          "id": "src.anthropic.claude-3-family-announcement"
        }
      ]
    },
    {
      "id": "fewer-refusals",
      "aspect": "safety",
      "direction": "changed",
      "text": "Anthropic says the Claude 3 models refuse borderline but harmless prompts less often than earlier Claude models.",
