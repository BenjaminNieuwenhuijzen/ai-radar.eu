  "summary": {
    "text": "Claude Fable 5.1 is a language model in Anthropic's Claude Fable line and the successor to Claude Fable 5, released on 1 September 2026 on the Claude apps, the Claude API and major cloud platforms. Anthropic says it is the same model as Claude Mythos 5.1 with different safeguards; token prices match Fable 5, cache reads cost less, and its text carries Anthropic's watermark.",
    "sources": [
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "September 1, 2026"
      },
