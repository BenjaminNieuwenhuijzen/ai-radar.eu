  "summary": {
    "text": "Claude Fable 5.2 is a language model in Anthropic's Claude Fable line and the successor to Claude Fable 5.1, released on 9 November 2026. Anthropic describes it as the same underlying model as Claude Mythos 5.2, with cybersecurity and biology safeguards that allow general availability, and lists token prices of 8 USD per million input tokens and 40 USD per million output tokens.",
    "sources": [
      {
        "id": "src.anthropic.claude-fable-5-2-mythos-5-2-announcement",
        "locator": "Introduction"
      },
      {
        "id": "src.anthropic.claude-fable-5-2-docs"
      }
    ]
  },
  "changes": [
    {
      "id": "price-speed",
      "aspect": "other",
      "direction": "changed",
      "text": "Anthropic states outputs are up to 30% faster than the 5.1 models, at 8 USD per million input and 40 USD per million output tokens, plus an optional fast mode at 16 and 80 USD.",
      "sources": [
        {
          "id": "src.anthropic.claude-fable-5-2-mythos-5-2-announcement",
          "locator": "Introduction"
        }
      ]
    },
    {
      "id": "safeguards",
      "aspect": "safety",
      "direction": "changed",
      "text": "Anthropic says the cyber and biology safeguards are as robust as those of Fable 5.1 but cause fewer unnecessary blocks, and that it added stronger protections against distillation attacks.",
      "sources": [
        {
          "id": "src.anthropic.claude-fable-5-2-mythos-5-2-announcement",
          "locator": "Safety and alignment"
        }
      ]
