  "summary": {
    "text": "Claude Fable 5 is a language model in Anthropic's Fable line, launched on 9 June 2026 on the Claude apps, the API and major cloud platforms. Anthropic describes it as a Mythos-class model whose classifiers route some cybersecurity, biology and chemistry requests to Claude Opus 4.8. Access was suspended on 12 June 2026 under US export controls and restored on Anthropic's own platforms from 1 July.",
    "sources": [
      {
        "id": "src.anthropic.claude-fable-5-mythos-5-announcement"
      },
      {
        "id": "src.anthropic.claude-fable-5-docs"
      },
      {
        "id": "src.anthropic.redeploying-fable-5"
      }
    ]
