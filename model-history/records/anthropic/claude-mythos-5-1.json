  "summary": {
    "text": "Claude Mythos 5.1 is a language model in Anthropic's Claude Mythos line and the successor to Claude Mythos 5, released on 1 September 2026 for Project Glasswing participants alongside Claude Fable 5.1. Anthropic says it is identical to Fable 5.1 but has more permissive safeguards for vetted organisations and individuals in cybersecurity and the life sciences. Access is by invitation only.",
    "sources": [
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "September 1, 2026"
      },
      {
        "id": "src.anthropic.claude-fable-5-1-mythos-5-1-announcement"
      },
      {
        "id": "src.anthropic.claude-mythos-5-1-docs"
      }
    ]
  },
