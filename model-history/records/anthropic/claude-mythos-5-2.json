  "summary": {
    "text": "Claude Mythos 5.2 is a language model in Anthropic's Claude Mythos line and the successor to Claude Mythos 5.1, released on 9 November 2026. Anthropic describes it as the same underlying model as Claude Fable 5.2 and offers it to organizations verified through its Cyber and Life Sciences Verification Programs; specifications and prices match Fable 5.2.",
    "sources": [
      {
        "id": "src.anthropic.claude-fable-5-2-mythos-5-2-announcement",
        "locator": "Introduction"
      },
      {
        "id": "src.anthropic.claude-mythos-5-2-docs"
      }
    ]
  },
  "changes": [
    {
      "id": "price-speed",
      "aspect": "other",
      "direction": "changed",
      "text": "Anthropic states outputs are up to 30% faster than the 5.1 models, at 8 USD per million input and 40 USD per million output tokens, plus an optional fast mode at 16 and 80 USD.",
