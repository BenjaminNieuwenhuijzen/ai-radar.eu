  "summary": {
    "text": "Claude Opus 4.6 is a language model in Anthropic's Claude Opus line, released on 5 February 2026 on claude.ai, the Claude API and major cloud platforms. It takes text and image input, launched with adaptive thinking and with context compaction in beta, and has a 1M token context window that was in beta at launch.",
    "sources": [
      {
        "id": "src.anthropic.claude-opus-4-6-announcement"
      },
      {
        "id": "src.anthropic.claude-opus-4-6-docs",
        "locator": "Capabilities"
      }
    ]
  },
  "changes": [
    {
      "id": "context-1m",
      "aspect": "context-length",
      "direction": "increased",
      "text": "Anthropic says it is the first Opus-class model with a 1M token context window, offered in beta at launch and out of beta from 13 March 2026.",
      "sources": [
        {
          "id": "src.anthropic.claude-opus-4-6-announcement"
        },
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "February 5, 2026; March 13, 2026"
        }
      ]
    },
    {
      "id": "adaptive-thinking",
      "aspect": "reasoning",
      "direction": "added",
      "text": "Adds adaptive thinking, in which the model decides how much to think, steered by the effort setting; manual thinking budgets are deprecated.",
      "sources": [
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "February 5, 2026"
        },
        {
          "id": "src.anthropic.claude-opus-4-6-announcement"
        }
      ]
    },
    {
      "id": "context-compaction",
      "aspect": "other",
      "direction": "added",
      "text": "Adds context compaction in beta on the API, which summarises older context during long-running tasks.",
      "sources": [
        {
          "id": "src.anthropic.claude-opus-4-6-announcement"
        },
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "February 5, 2026"
        }
      ]
    },
