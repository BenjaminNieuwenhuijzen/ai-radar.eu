  "summary": {
    "text": "Claude Opus 4.7 is a language model in Anthropic's Claude Opus line, released on 16 April 2026 across Claude products, the Claude API and major cloud platforms at the Opus 4.6 price. It accepts higher-resolution images and uses an updated tokenizer; Anthropic released it with safeguards that detect and block prohibited or high-risk cybersecurity requests.",
    "sources": [
      {
        "id": "src.anthropic.claude-opus-4-7-announcement"
      }
    ]
  },
  "changes": [
    {
      "id": "image-resolution",
      "aspect": "modality",
      "direction": "changed",
      "text": "Accepts higher-resolution images, up to 2,576 pixels on the long edge instead of 1,568.",
      "sources": [
        {
          "id": "src.anthropic.claude-opus-4-7-announcement"
        },
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "April 16, 2026"
        }
      ]
    },
    {
      "id": "tokenizer",
      "aspect": "other",
      "direction": "changed",
      "text": "Uses an updated tokenizer; Anthropic says the same input can map to roughly 1.0 to 1.35 times as many tokens.",
      "sources": [
        {
          "id": "src.anthropic.claude-opus-4-7-announcement"
        }
      ]
    },
    {
      "id": "cyber-safeguards",
      "aspect": "safety",
      "direction": "added",
      "text": "Ships with safeguards that automatically detect and block prohibited or high-risk cybersecurity requests.",
