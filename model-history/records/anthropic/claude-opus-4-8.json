  "summary": {
    "text": "Claude Opus 4.8 is a language model in Anthropic's Claude Opus line, released on 28 May 2026 at the Opus 4.7 price and available on the Claude API and major cloud platforms. It takes text and image input with a 1M token context window, added mid-conversation system messages, and later served as the fallback for requests that Claude Fable 5's safeguards blocked.",
    "sources": [
      {
        "id": "src.anthropic.claude-opus-4-8-announcement"
      },
      {
        "id": "src.anthropic.claude-opus-4-8-docs"
      },
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "May 28, 2026"
      },
      {
        "id": "src.anthropic.claude-fable-5-mythos-5-announcement"
      }
    ]
  },
