  "summary": {
    "text": "Claude Opus 4 is a language model in Anthropic's Opus line that accepts text and images, released together with Claude Sonnet 4 and offered in paid Claude plans, on the Anthropic API, Amazon Bedrock and Google Cloud Vertex AI. Anthropic describes it as a hybrid model with near-instant answers and an extended thinking mode, and released it under its ASL-3 Standard as a precaution.",
    "sources": [
      {
        "id": "src.anthropic.claude-4-announcement"
      },
      {
        "id": "src.anthropic.transparency-hub-model-report",
        "locator": "Claude Opus 4 and Claude Sonnet 4 Summary Table, Modalities"
      },
      {
        "id": "src.anthropic.claude-4-system-card"
      }
    ]
  },
