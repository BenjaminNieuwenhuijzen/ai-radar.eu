          "id": "src.anthropic.api-release-notes",
          "locator": "September 22, 2026"
        }
      ]
    },
    {
      "id": "thinking-always-on",
      "aspect": "reasoning",
      "direction": "removed",
      "text": "Thinking can no longer be switched off; its depth is set with the effort parameter.",
