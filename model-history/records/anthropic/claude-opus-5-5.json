  "summary": {
    "text": "Claude Opus 5.5 is a language model in Anthropic's Claude Opus line and, according to Anthropic, the first model of its Claude 5.5 family, released on 22 September 2026 on all platforms. It costs less per token than Claude Opus 5, has adaptive thinking that cannot be switched off, is available with zero data retention and carries Anthropic's output watermarking.",
    "sources": [
      {
        "id": "src.anthropic.claude-opus-5-5-announcement"
      },
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "September 22, 2026"
      }
    ]
  },
  "changes": [
    {
      "id": "price",
      "aspect": "other",
      "direction": "changed",
      "text": "Priced at 4 USD input and 20 USD output per million tokens, down from 5 and 25 USD for Opus 5; cache reads cost 0.20 USD.",
      "sources": [
        {
          "id": "src.anthropic.claude-opus-5-5-announcement"
        },
