  "summary": {
    "text": "Claude Opus 5 is a language model in Anthropic's Claude Opus line, released on 24 July 2026 on all platforms at the same price as Claude Opus 4.8 and made the default model on Claude Max. It takes text and image input with a 1M token context window, has thinking on by default, and uses cyber classifiers that allow finding vulnerabilities in source code but block exploit generation.",
    "sources": [
      {
        "id": "src.anthropic.claude-opus-5-announcement"
      },
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "July 24, 2026"
      },
      {
        "id": "src.anthropic.claude-opus-5-docs"
      }
    ]
  },
  "changes": [
    {
      "id": "thinking-default",
      "aspect": "reasoning",
      "direction": "changed",
      "text": "Thinking is on by default, and it can be disabled only at effort high or below.",
      "sources": [
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "July 24, 2026"
        }
      ]
    },
    {
      "id": "cyber-classifiers",
      "aspect": "safety",
      "direction": "changed",
      "text": "Cyber safeguards similar to Opus 4.8's, with stronger guardrails on binary vulnerability scanning, penetration testing and exploit generation; flagged requests fall back to Opus 4.8.",
