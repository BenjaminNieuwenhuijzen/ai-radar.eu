  "summary": {
    "text": "Claude Sonnet 4 is a language model in Anthropic's Sonnet line that accepts text and images, released together with Claude Opus 4. It was offered to free and paid Claude users, on the Anthropic API, Amazon Bedrock and Google Cloud Vertex AI, with near-instant answers and an extended thinking mode, and Anthropic presents it as an upgrade to Claude 3.7 Sonnet.",
    "sources": [
      {
        "id": "src.anthropic.claude-4-announcement"
      },
      {
        "id": "src.anthropic.transparency-hub-model-report",
        "locator": "Claude Opus 4 and Claude Sonnet 4 Summary Table, Modalities"
      }
    ]
  },
  "changes": [
    {
      "id": "tools-in-thinking",
      "aspect": "tool-use",
      "direction": "added",
      "relativeTo": "anthropic.claude-3-7-sonnet",
      "text": "Can use tools such as web search during extended thinking; this was in beta at launch.",
      "sources": [
        {
          "id": "src.anthropic.claude-4-announcement"
        }
      ]
    },
    {
      "id": "thinking-summaries",
      "aspect": "reasoning",
      "direction": "changed",
      "relativeTo": "anthropic.claude-3-7-sonnet",
      "text": "Long thought processes are condensed by a smaller model, where Claude 3.7 Sonnet always showed its raw thinking; Anthropic says this is needed in about 5% of cases.",
      "sources": [
        {
          "id": "src.anthropic.claude-4-system-card"
        },
        {
          "id": "src.anthropic.claude-4-announcement"
        }
      ]
    },
    {
      "id": "training-data",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "anthropic.claude-3-7-sonnet",
      "text": "Training data includes public web data as of March 2025, against November 2024 for Claude 3.7 Sonnet.",
      "sources": [
        {
          "id": "src.anthropic.claude-4-system-card"
        },
        {
          "id": "src.anthropic.claude-3-7-sonnet-system-card"
        }
      ]
    },
