  "summary": {
    "text": "Claude Sonnet 5.5 is a language model in Anthropic's Claude Sonnet line, released on 28 September 2026 on all platforms at the same price as Claude Sonnet 5; Anthropic calls it the second model of its Claude 5.5 family. Anthropic says it is the first Sonnet model with classifiers that block reasoning extraction, and its thinking blocks are tied to the account that produced them.",
    "sources": [
      {
        "id": "src.anthropic.claude-sonnet-5-5-announcement"
      },
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "September 28, 2026"
      }
    ]
  },
  "changes": [
    {
      "id": "reasoning-extraction-classifiers",
      "aspect": "safety",
      "direction": "added",
      "text": "Adds safety classifiers that block reasoning extraction, which Anthropic says is a first for a Sonnet model.",
      "sources": [
        {
          "id": "src.anthropic.claude-sonnet-5-5-announcement"
        }
      ]
    },
    {
      "id": "between-tools",
      "aspect": "reasoning",
      "direction": "changed",
      "text": "Up-front thinking is turned off with the new between_tools setting instead of the disabled value, at high effort or below.",
      "sources": [
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "September 28, 2026"
        }
      ]
    },
    {
      "id": "forced-tool-use",
      "aspect": "tool-use",
      "direction": "removed",
      "text": "Forced tool use (tool_choice types any and tool) returns an error.",
      "sources": [
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "September 28, 2026"
        }
      ]
    },
    {
      "id": "computer-use-tool",
