  "summary": {
    "text": "Claude Sonnet 5 is a language model that Anthropic calls the next generation of its Sonnet family, released on 30 June 2026 on all Claude plans, the Claude API and major cloud platforms, and made the default for Free and Pro users. It takes text and image input with a 1M token context window, has adaptive thinking on by default and launched with cyber safeguards enabled.",
    "sources": [
      {
        "id": "src.anthropic.claude-sonnet-5-announcement"
      },
      {
        "id": "src.anthropic.api-release-notes",
        "locator": "June 30, 2026"
      },
      {
        "id": "src.anthropic.claude-sonnet-5-docs"
      }
    ]
  },
  "changes": [
    {
      "id": "adaptive-thinking-default",
      "aspect": "reasoning",
      "direction": "changed",
      "text": "Adaptive thinking is on by default; manual extended thinking budgets, deprecated on Sonnet 4.6, now return an error.",
      "sources": [
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "June 30, 2026"
        }
      ]
    },
    {
      "id": "tokenizer",
      "aspect": "other",
      "direction": "changed",
      "text": "Uses a new tokenizer; the release notes estimate about 30% more tokens for the same text, depending on the content.",
      "sources": [
        {
          "id": "src.anthropic.api-release-notes",
          "locator": "June 30, 2026"
        }
      ]
    },
    {
      "id": "price",
      "aspect": "other",
      "direction": "changed",
      "text": "Priced at 2 USD input and 10 USD output per million tokens, against 3 and 15 USD for Sonnet 4.6; the introductory price became standard on 10 August 2026.",
