  "summary": {
    "text": "Command R is a text-only language model in Cohere's R series, launched on 11 March 2024 for large-scale production use, with a 128k-token context, retrieval-augmented generation with citations, tool use and a focus on 10 business languages. It was offered on the Cohere API, with 35-billion-parameter research weights on Hugging Face; the hosted model was deprecated on 15 September 2025.",
    "sources": [
      {
        "id": "src.cohere.command-r-announcement"
      },
      {
        "id": "src.cohere.hf-c4ai-command-r-v01"
      },
