  "summary": {
    "text": "DeepSeek-R1-0528 is a minor version upgrade of DeepSeek-R1, served behind deepseek-reasoner in the DeepSeek API from 28 May 2025, in the web chat and as open weights under the MIT License. DeepSeek says it reasons more deeply and hallucinates less, and unlike earlier R1 versions it supports a system prompt.",
    "sources": [
      {
        "id": "src.deepseek.deepseek-r1-0528-hf"
      },
