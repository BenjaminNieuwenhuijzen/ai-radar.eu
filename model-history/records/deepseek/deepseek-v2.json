  "summary": {
    "text": "DeepSeek-V2 is a mixture-of-experts language model from DeepSeek with 236B total parameters, 21B of them activated per token, and a 128K-token context, released as open weights and offered on DeepSeek's chat website and API. It introduced Multi-head Latent Attention, which compresses the key-value cache; smaller DeepSeek-V2-Lite models followed on 2024-05-16.",
    "sources": [
      {
        "id": "src.deepseek.deepseek-v2-github",
        "locator": "2. News; 3. Model Downloads; 6. Chat Website; 7. API Platform"
      },
      {
        "id": "src.deepseek.deepseek-v2-paper",
        "locator": "abstract"
      },
      {
        "id": "src.deepseek.deepseek-v2-lite-hf",
        "locator": "2. News"
      }
    ]
  },
  "changes": [
    {
      "id": "moe-mla",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "deepseek.deepseek-llm",
      "text": "Moves from a dense transformer to a mixture-of-experts design (DeepSeekMoE) and adds the new Multi-head Latent Attention.",
      "sources": [
        {
          "id": "src.deepseek.deepseek-v2-paper"
        }
      ]
    },
    {
      "id": "context-128k",
      "aspect": "context-length",
      "direction": "increased",
      "relativeTo": "deepseek.deepseek-llm",
      "text": "Context length of 128K tokens, up from the 4,096-token sequence length of DeepSeek LLM.",
      "sources": [
        {
          "id": "src.deepseek.deepseek-v2-github",
          "locator": "3. Model Downloads"
        },
        {
          "id": "src.deepseek.deepseek-llm-github",
          "locator": "2. Model Downloads, Sequence Length"
        }
      ]
    },
    {
      "id": "training-corpus",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "deepseek.deepseek-llm",
      "text": "Pre-trained on 8.1 trillion tokens; DeepSeek says the corpus holds more data than that of DeepSeek 67B, especially Chinese data, at higher quality.",
      "sources": [
        {
          "id": "src.deepseek.deepseek-v2-paper",
          "locator": "section 3.1.1, Data Construction"
        }
      ]
    },
    {
      "id": "efficiency",
      "aspect": "efficiency",
      "relativeTo": "deepseek.deepseek-llm",
      "text": "DeepSeek reports lower training cost, a much smaller key-value cache and higher maximum generation throughput than DeepSeek 67B.",
