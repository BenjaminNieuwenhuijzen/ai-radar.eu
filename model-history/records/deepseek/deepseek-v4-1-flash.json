  "summary": {
    "text": "DeepSeek-V4.1-Flash is a Mixture-of-Experts model with 552B backbone parameters that takes text and images and generates text, released on 2026-09-10 in the DeepSeek API as deepseek-flash and with open weights under the MIT License. DeepSeek calls it the smallest model of a new architecture family and says it was trained from scratch.",
    "sources": [
      {
        "id": "src.deepseek.hf-deepseek-v4-1-flash",
        "locator": "Introduction; License"
      },
      {
        "id": "src.deepseek.news-v4-1-flash"
      }
    ]
  },
  "changes": [
    {
      "id": "native-image-input",
      "aspect": "modality",
      "direction": "added",
      "relativeTo": "deepseek.deepseek-v4-flash-0731",
      "text": "Processes images natively together with text, trained jointly from the start of pre-training; the previous Flash model accepted text only.",
      "sources": [
        {
          "id": "src.deepseek.hf-deepseek-v4-1-flash",
          "locator": "Introduction"
        }
      ]
    },
    {
      "id": "causal-encoder-decoder",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "deepseek.deepseek-v4-flash-0731",
      "text": "Switches to a Causal Encoder-Decoder design with 8B active parameters for input and 16B for output, plus CSA2 sparse attention and Engram conditional memory.",
      "sources": [
        {
          "id": "src.deepseek.hf-deepseek-v4-1-flash",
          "locator": "Introduction"
        }
      ]
    },
    {
      "id": "trained-from-scratch",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "deepseek.deepseek-v4-flash-0731",
      "text": "Trained from scratch on a 45T-token multimodal corpus, rather than derived from a V4 checkpoint.",
      "sources": [
        {
          "id": "src.deepseek.hf-deepseek-v4-1-flash"
        }
      ]
    },
    {
      "id": "kv-cache",
      "aspect": "efficiency",
      "direction": "changed",
      "relativeTo": "deepseek.deepseek-v4-flash-0731",
      "text": "According to DeepSeek, its KV cache needs about a quarter of the HBM and an eighth of the SSD storage of the previous generation.",
      "sources": [
        {
          "id": "src.deepseek.news-v4-1-flash"
        }
      ]
    }
