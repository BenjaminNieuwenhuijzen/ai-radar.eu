    {
      "id": "hybrid-attention",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "deepseek.deepseek-v3-2",
      "text": "Uses the V4 hybrid attention design (Compressed Sparse Attention plus Heavily Compressed Attention), Manifold-Constrained Hyper-Connections and the Muon optimizer.",
