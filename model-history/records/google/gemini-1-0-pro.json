  "summary": {
    "text": "Gemini 1.0 Pro is the Gemini 1.0 size Google meant for a wide range of tasks. A tuned version ran in Bard from December 2023, and a week later it reached developers through the Gemini API and Vertex AI with a 32K-token context window, taking text only, with images through a separate Pro Vision endpoint. The Gemini API stopped supporting it in February 2025.",
    "sources": [
      {
        "id": "src.google.gemini-1-announcement"
      },
      {
        "id": "src.google.bard-gemini-pro-announcement"
      },
      {
        "id": "src.google.gemini-pro-developers-announcement"
      },
      {
        "id": "src.google.gemini-api-release-notes"
      }
    ]
  },
