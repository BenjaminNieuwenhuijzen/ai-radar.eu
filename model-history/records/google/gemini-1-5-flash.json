  "summary": {
    "text": "Gemini 1.5 Flash is a Google model that accepts text, images, audio and video and returns text, introduced at Google I/O 2024 in public preview in Google AI Studio and Vertex AI with a 1 million token context window. Google says it was distilled from 1.5 Pro to be fast and efficient to serve; from July 2024 it also ran the free Gemini app.",
    "sources": [
      {
        "id": "src.google.io-2024-gemini-updates"
      },
      {
        "id": "src.google.io-2024-developer-updates"
      },
