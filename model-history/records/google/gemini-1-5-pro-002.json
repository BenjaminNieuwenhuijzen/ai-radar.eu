  "summary": {
    "text": "Gemini-1.5-Pro-002 is an updated, production-ready version of Google's Gemini 1.5 Pro, released with Gemini-1.5-Flash-002 through Google AI Studio, the Gemini API and Vertex AI, with a 2 million token context window. Google says it builds on recent experimental releases; a chat-optimized version came to Gemini Advanced in October 2024.",
    "sources": [
      {
        "id": "src.google.gemini-1-5-002-models-announcement"
      },
      {
        "id": "src.google.gemini-app-release-notes",
        "locator": "2024.10.02"
      }
    ]
  },
  "changes": [
    {
      "id": "concise",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "google.gemini-1-5-pro",
      "text": "Gives more concise answers by default, which Google says makes the model easier and cheaper to use.",
      "sources": [
        {
          "id": "src.google.gemini-1-5-002-models-announcement"
        }
      ]
    },
    {
      "id": "safety-filters",
      "aspect": "safety",
      "direction": "changed",
      "relativeTo": "google.gemini-1-5-pro",
      "text": "Safety filters are no longer applied by default; developers choose the configuration.",
      "sources": [
        {
          "id": "src.google.gemini-1-5-002-models-announcement"
        }
      ]
    },
    {
      "id": "quality",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "google.gemini-1-5-pro",
      "text": "Google reports quality improvements, notably in math, long context and vision.",
      "sources": [
        {
          "id": "src.google.gemini-1-5-002-models-announcement"
        }
      ]
    },
    {
      "id": "price-rate-limits",
      "aspect": "availability",
      "direction": "changed",
      "relativeTo": "google.gemini-1-5-pro",
      "text": "Released with a price cut of more than half for 1.5 Pro prompts under 128K tokens, effective 2024-10-01, and higher paid-tier rate limits.",
      "sources": [
        {
          "id": "src.google.gemini-1-5-002-models-announcement"
        }
      ]
    }
