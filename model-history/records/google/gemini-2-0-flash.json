  "summary": {
    "text": "Gemini 2.0 Flash is the first model of Google's Gemini 2.0 family, released as an experimental model in December 2024 and generally available from February 2025 through the Gemini API, Google AI Studio and Vertex AI, and in the Gemini app. It accepts text, images, audio and video, and Google says it can natively call tools such as Google Search and code execution.",
    "sources": [
      {
        "id": "src.google.gemini-2-0-announcement"
      },
      {
        "id": "src.google.gemini-2-0-family-expands-developers"
      },
      {
        "id": "src.google.gemini-2-0-model-updates-february-2025"
      },
      {
        "id": "src.google.gemini-2-0-flash-model-card",
        "locator": "Model Information, Inputs"
      }
    ]
  },
