  "summary": {
    "text": "Gemini 2.5 Flash is a multimodal reasoning model in Google's Gemini Flash line, released in preview on 17 April 2025 and generally available from 17 June 2025 in the Gemini API and the Gemini app. Google calls it its first fully hybrid reasoning model: thinking can be turned on or off and capped with a budget of up to 24,576 tokens.",
    "sources": [
      {
        "id": "src.google.gemini-2-5-flash-dev-blog"
      },
      {
        "id": "src.google.gemini-2-5-thinking-model-updates-dev-blog"
      },
      {
        "id": "src.google.gemini-api-release-notes",
        "locator": "April 17, 2025; June 17, 2025"
      }
    ]
  },
