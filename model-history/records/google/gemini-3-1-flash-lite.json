  "summary": {
    "text": "Gemini 3.1 Flash-Lite is a multimodal language model and the first Flash-Lite model of Google's Gemini 3 series, released in preview on 3 March 2026 in the Gemini API and Vertex AI and generally available since 7 May 2026. Google aims it at high-volume workloads such as translation and content moderation, with thinking levels as standard.",
    "sources": [
      {
        "id": "src.google.gemini-3-1-flash-lite-announcement"
      },
      {
        "id": "src.google.gemini-api-release-notes",
        "locator": "March 3, 2026; May 7, 2026"
      }
    ]
  },
