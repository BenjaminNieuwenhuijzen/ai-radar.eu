  "summary": {
    "text": "Gemini 3.8 Flash is a multimodal reasoning model in Google's Flash line with adjustable effort levels, released on 2 September 2026 and based on Gemini 3.7 Flash. Google aims it at long-horizon software engineering, autonomous agents and enterprise workflows; it was offered through the Gemini API, Google Antigravity, Stitch and Gemini Enterprise, and to Google AI Pro and Ultra subscribers.",
    "sources": [
      {
        "id": "src.google.gemini-3-8-flash-announcement"
      },
      {
        "id": "src.google.gemini-3-8-flash-model-card"
      },
      {
        "id": "src.google.gemini-api-changelog",
        "locator": "September 2, 2026"
      }
    ]
  },
  "changes": [
    {
      "id": "extra-reasoning",
      "aspect": "reasoning",
      "direction": "changed",
      "relativeTo": "google.gemini-3-7-flash",
      "text": "Takes extra reasoning steps and calls tools repeatedly on complex tasks, so Google says it can use more tokens at higher effort levels; 3.7 Flash stays supported.",
      "sources": [
        {
          "id": "src.google.gemini-3-8-flash-announcement"
        }
      ]
    },
    {
      "id": "task-improvements",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "google.gemini-3-7-flash",
      "text": "Google says software engineering, agentic tasks and multi-step reasoning in specialised domains improved over 3.7 Flash.",
      "sources": [
        {
          "id": "src.google.gemini-3-8-flash-model-card"
        }
      ]
    },
    {
      "id": "prompt-injection",
      "aspect": "safety",
      "direction": "changed",
      "relativeTo": "google.gemini-3-7-flash",
      "text": "Google reports that the Gemini 3.8 models are more robust against prompt-injection attacks.",
      "sources": [
        {
          "id": "src.google.gemini-3-8-flash-announcement"
        }
      ]
    },
    {
      "id": "consumer-access",
      "aspect": "availability",
      "direction": "changed",
      "relativeTo": "google.gemini-3-7-flash",
      "text": "Offered to Google AI Pro and Ultra subscribers in the Gemini app, AI Mode in Google Search and Gemini in Google Sheets, where 3.7 Flash reached consumers only through Gemini Spark.",
      "sources": [
        {
          "id": "src.google.gemini-3-8-flash-announcement"
        }
      ]
    }
