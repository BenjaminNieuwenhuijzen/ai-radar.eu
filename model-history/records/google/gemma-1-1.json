  "summary": {
    "text": "Gemma 1.1 is an update to Google's first-generation Gemma open models, released as instruction-tuned 2B and 7B checkpoints with downloadable weights under Google's Gemma terms of use. Google describes them as English-language, text-to-text, decoder-only language models, post-trained with a new RLHF method.",
    "sources": [
      {
        "id": "src.google.gemma-1-1-7b-it-hf"
      },
      {
        "id": "src.google.gemma-1-1-2b-it-hf"
      }
    ]
  },
