  "summary": {
    "text": "Gemma 2 is the second generation of Google's Gemma open-weight language models, released in 9B and 27B sizes with weights on Kaggle and Hugging Face, followed by a 2B size in July 2024. Google says it uses a redesigned architecture aimed at performance and inference efficiency, and it trained the 2B and 9B models with knowledge distillation.",
    "sources": [
      {
        "id": "src.google.gemma-2-announcement"
      },
      {
        "id": "src.google.gemma-2-2b-announcement"
      },
      {
        "id": "src.google.gemma-2-technical-report"
      }
    ]
  },
  "changes": [
    {
      "id": "attention",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "google.gemma-1-1",
      "text": "Alternates local sliding-window and global attention layers and adds grouped-query attention and logit soft-capping, with deeper networks.",
      "sources": [
        {
          "id": "src.google.gemma-2-technical-report",
          "locator": "section 2, Model Architecture"
        }
      ]
    },
    {
      "id": "distillation",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "google.gemma-1-1",
      "text": "The 2B and 9B models are trained with knowledge distillation from a larger teacher model instead of next-token prediction; the 27B model is trained from scratch.",
      "sources": [
        {
          "id": "src.google.gemma-2-technical-report"
        }
      ]
    },
    {
      "id": "sizes",
      "aspect": "size",
      "direction": "added",
      "relativeTo": "google.gemma-1-1",
      "text": "Adds 9B and 27B sizes; the small model that followed in July 2024 has about 2.6B parameters.",
      "sources": [
        {
          "id": "src.google.gemma-2-announcement"
        },
        {
          "id": "src.google.gemma-2-technical-report",
          "locator": "Table 2"
        }
      ]
    },
    {
      "id": "post-training",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "google.gemma-1-1",
      "text": "Post-training extends the Gemma 1.1 data with more internal and public data and uses a similar RLHF algorithm with a much larger reward model.",
      "sources": [
        {
          "id": "src.google.gemma-2-technical-report",
          "locator": "section 4, Post-Training"
        }
      ]
    }
  ],
