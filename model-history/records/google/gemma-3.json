  "summary": {
    "text": "Gemma 3 is a family of open-weight models from Google, released on 12 March 2025 in 1B, 4B, 12B and 27B sizes, with a 270M size added in August 2025. Google says it is built from the same research and technology as Gemini 2.0; the 4B, 12B and 27B sizes accept images as well as text and have a 128K-token context window.",
    "sources": [
      {
        "id": "src.google.gemma-3-developer-guide"
      },
      {
        "id": "src.google.gemma-3-announcement"
      },
      {
        "id": "src.google.gemma-3-270m-announcement"
      },
      {
        "id": "src.google.gemma-3-technical-report",
        "locator": "Table 1"
      },
      {
        "id": "src.google.gemma-3-model-card",
        "locator": "Inputs and outputs"
      }
    ]
  },
  "changes": [
    {
      "id": "vision",
      "aspect": "modality",
      "direction": "added",
      "relativeTo": "google.gemma-2",
      "text": "Adds image input for the 4B, 12B and 27B sizes through a shared vision encoder; the 1B size stays text-only.",
      "sources": [
        {
          "id": "src.google.gemma-3-technical-report",
          "locator": "Table 1; section 2, vision encoder"
        }
      ]
    },
    {
      "id": "context-length",
      "aspect": "context-length",
      "direction": "increased",
      "relativeTo": "google.gemma-2",
      "text": "Context window raised to 128K tokens for the 4B, 12B and 27B sizes and to 32K for the 1B size.",
      "sources": [
        {
          "id": "src.google.gemma-3-technical-report",
          "locator": "section 2, long context"
        }
      ]
    },
    {
      "id": "languages",
      "aspect": "languages",
      "direction": "increased",
      "relativeTo": "google.gemma-2",
      "text": "Wider language coverage: out-of-the-box support for over 35 languages and pretrained support for over 140.",
      "sources": [
        {
          "id": "src.google.gemma-3-announcement",
          "locator": "New capabilities"
        }
      ]
    },
    {
      "id": "attention",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "google.gemma-2",
      "text": "Uses five local attention layers per global layer, with a short local span to limit KV-cache memory, and QK-norm instead of the soft-capping of Gemma 2.",
      "sources": [
        {
          "id": "src.google.gemma-3-technical-report"
        }
      ]
    }
  ],
