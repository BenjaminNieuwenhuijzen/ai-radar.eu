  "summary": {
    "text": "Gemma 4 is a family of open-weight models from Google, released on 2 April 2026 under the Apache 2.0 licence in E2B, E4B, 26B Mixture-of-Experts and 31B dense sizes, with a 12B Unified size added in June 2026. All sizes take text, image and video input and return text. Google says Gemma 4 is built from the same research and technology as Gemini 3.",
    "sources": [
      {
        "id": "src.google.gemma-4-announcement"
      },
      {
        "id": "src.google.gemma-4-model-card"
      },
      {
        "id": "src.google.gemma-4-12b-announcement"
      }
    ]
  },
