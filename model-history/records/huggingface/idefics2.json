  "summary": {
    "text": "Idefics2 is an 8B multimodal model from Hugging Face that takes interleaved text and images and generates text, published as open weights under Apache 2.0 in base, instruction-tuned and chatty checkpoints. It is built on Mistral-7B-v0.1 and SigLIP, handles images at native resolution up to 980 x 980 pixels, and Hugging Face says it has enhanced OCR compared with Idefics1.",
    "sources": [
      {
        "id": "src.huggingface.idefics2-announcement"
      },
      {
        "id": "src.huggingface.idefics2-8b-model-card",
        "locator": "first paragraph"
      }
    ]
  },
  "changes": [
    {
      "id": "size",
      "aspect": "size",
      "direction": "decreased",
      "relativeTo": "huggingface.idefics-1",
      "text": "A single 8B size instead of 9B and 80B; Hugging Face calls it 10x smaller than the 80B model.",
      "sources": [
        {
          "id": "src.huggingface.idefics2-announcement"
        }
      ]
    },
    {
      "id": "architecture",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "huggingface.idefics-1",
      "text": "Replaces gated cross-attention with Perceiver pooling and an MLP projection, and uses Mistral-7B-v0.1 and SigLIP so400m as backbones.",
      "sources": [
        {
          "id": "src.huggingface.idefics2-announcement"
        }
      ]
    },
    {
      "id": "training-data",
      "aspect": "training-data",
      "direction": "added",
      "relativeTo": "huggingface.idefics-1",
      "text": "Adds OCR, document and image-to-code training data, plus The Cauldron, a new instruction dataset compiled from 50 curated datasets.",
      "sources": [
        {
          "id": "src.huggingface.idefics2-announcement"
        }
      ]
    },
    {
      "id": "licence",
      "aspect": "licensing",
