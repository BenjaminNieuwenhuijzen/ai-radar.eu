  "summary": {
    "text": "Idefics3 is an 8B open-weight multimodal model from Hugging Face that takes interleaved images and text and produces text, built on Meta's Llama 3.1 8B Instruct and Google's SigLIP-SO400M and released under Apache 2.0. Hugging Face says it improves on Idefics2 in OCR, document understanding and visual reasoning, and released the Docmatix dataset with it.",
    "sources": [
      {
        "id": "src.huggingface.idefics3-model-card"
      },
      {
        "id": "src.huggingface.idefics3-paper"
      }
    ]
  },
