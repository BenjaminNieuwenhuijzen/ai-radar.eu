  "summary": {
    "text": "SmolVLM is a 2B open-weight vision-language model from Hugging Face that takes sequences of images and text and produces text, released as Base, Synthetic and Instruct checkpoints under Apache 2.0. It follows the Idefics3 architecture with SmolLM2 1.7B as language backbone; Hugging Face calls it suitable for on-device use and added 256M and 500M sizes in January 2025.",
    "sources": [
      {
        "id": "src.huggingface.smolvlm-announcement"
      },
      {
        "id": "src.huggingface.smolvlm-instruct-model-card"
      },
      {
        "id": "src.huggingface.smolvlm-256m-500m-announcement"
      }
    ]
  },
