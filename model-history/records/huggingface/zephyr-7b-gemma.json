  "summary": {
    "text": "Zephyr 7B Gemma is the third model in Hugging Face's Zephyr series, a 7B chat assistant fine-tuned from Google's Gemma 7B and published as open weights under the Gemma Terms of Use. It was fine-tuned on the DEITA 10K dataset, aligned with DPO on about 7k GPT-4-ranked prompts, and released with an Alignment Handbook recipe for aligning Gemma 7B with RLAIF.",
    "sources": [
      {
        "id": "src.huggingface.zephyr-7b-gemma-model-card"
      },
      {
        "id": "src.huggingface.alignment-handbook",
        "locator": "README, News: March 1, 2024"
      }
    ]
  },
