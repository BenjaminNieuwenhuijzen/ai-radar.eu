  "summary": {
    "text": "Llama 2 is the second generation of Meta's Llama language models for text, released on 18 July 2023 at 7B, 13B and 70B parameters, each with a dialogue-tuned Llama 2-Chat version. Meta made the weights free for research and commercial use and, with Microsoft as preferred partner, offered the models through Azure, AWS, Hugging Face and other providers.",
    "sources": [
      {
        "id": "src.meta.llama-2-announcement"
      },
      {
        "id": "src.meta.llama-2-paper"
      },
      {
        "id": "src.meta.llama-2-hf-collection"
      }
    ]
  },
