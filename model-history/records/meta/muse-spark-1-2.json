  "summary": {
    "text": "Muse Spark 1.2 is a multimodal reasoning model in Meta's Muse series that Meta describes as a coding-focused update to Muse Spark 1.1. It was released with Muse Code, a terminal coding agent in beta that it powers, and the Meta Model API offers it on a Standard tier and a discounted Contributor tier that lets Meta train on prompts and completions.",
    "sources": [
      {
        "id": "src.meta.muse-code-and-muse-spark-1-2-blog"
      },
      {
        "id": "src.meta.model-api-models",
        "locator": "Available Muse Spark models"
      }
    ]
  },
  "changes": [
    {
      "id": "coding-training",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "meta.muse-spark-1-1",
      "text": "Meta says it scaled up training compute on coding tasks, with more varied training environments and long-horizon tasks such as whole-repository generation.",
      "sources": [
        {
          "id": "src.meta.muse-code-and-muse-spark-1-2-blog"
        }
      ]
    },
    {
      "id": "muse-code-cotraining",
      "aspect": "other",
      "direction": "added",
      "relativeTo": "meta.muse-spark-1-1",
      "text": "Co-trained with the Muse Code agent harness so that it works with that agent's tools, goals, compaction and subagents.",
      "sources": [
        {
          "id": "src.meta.muse-code-and-muse-spark-1-2-blog"
        }
      ]
    },
    {
      "id": "instruction-following",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "meta.muse-spark-1-1",
      "text": "Meta says it follows complex instructions more precisely, helped by training data that Muse Spark 1.1 generated and graded.",
      "sources": [
        {
          "id": "src.meta.muse-code-and-muse-spark-1-2-blog"
        }
      ]
    },
    {
      "id": "contributor-tier",
      "aspect": "availability",
      "direction": "added",
      "relativeTo": "meta.muse-spark-1-1",
      "text": "Also offered on a discounted Contributor tier that lets Meta train on customer prompts and completions; Muse Spark 1.1 has no such tier.",
      "sources": [
        {
          "id": "src.meta.model-api-models",
          "locator": "Available Muse Spark models"
        }
      ]
    }
  ],
