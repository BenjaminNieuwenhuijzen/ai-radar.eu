      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "microsoft.phi-3",
      "text": "Phi-3.5-mini adds continued pre-training on multilingual synthetic and filtered data, and proximal policy optimization in post-training.",
      "sources": [
