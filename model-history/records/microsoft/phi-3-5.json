  "summary": {
    "text": "Phi-3.5 is a Microsoft release of two open-weight text models announced on 22 August 2024: Phi-3.5-mini (3.8 billion parameters) and the mixture-of-experts Phi-3.5-MoE (42 billion in total, 6.6 billion active). Both support multiple languages and 128K tokens of context; Phi-3.5-mini was also offered on a serverless endpoint in Azure AI Studio.",
    "sources": [
      {
        "id": "src.microsoft.phi-3-5-announcement"
      },
      {
        "id": "src.microsoft.phi-3-5-mini-instruct-model-card"
      },
      {
        "id": "src.microsoft.phi-3-5-moe-instruct-model-card"
      }
    ]
  },
  "changes": [
    {
      "id": "multilingual",
      "aspect": "languages",
      "direction": "added",
      "relativeTo": "microsoft.phi-3",
      "text": "Adds multilingual support: the Phi-3.5-mini card lists 23 languages, and Microsoft says Phi-3.5-MoE supports more than 20.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-5-mini-instruct-model-card"
        },
        {
          "id": "src.microsoft.phi-3-5-announcement"
        }
      ]
    },
    {
      "id": "mixture-of-experts",
      "aspect": "architecture",
      "direction": "added",
      "relativeTo": "microsoft.phi-3",
      "text": "Adds a mixture-of-experts model, Phi-3.5-MoE, with 16 experts of 3.8 billion parameters each; 6.6 billion of its 42 billion parameters are active.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-5-announcement"
        },
        {
          "id": "src.microsoft.phi-3-5-moe-instruct-model-card"
        }
      ]
    },
    {
      "id": "long-context-only",
      "aspect": "context-length",
      "direction": "changed",
      "relativeTo": "microsoft.phi-3",
      "text": "Phi-3.5-mini comes only in a 128K-token version, where Phi-3-mini also had a 4K version; the report describes LongRoPE to extend the context.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-technical-report"
        },
        {
          "id": "src.microsoft.phi-3-5-mini-instruct-model-card"
        },
        {
          "id": "src.microsoft.phi-3-announcement"
        }
      ]
    },
    {
