  "summary": {
    "text": "Phi-3 is a family of instruction-tuned small language models from Microsoft in three sizes: Phi-3-mini (3.8 billion parameters), released on 23 April 2024, and Phi-3-small (7 billion) and Phi-3-medium (14 billion), released at Microsoft Build on 21 May 2024. Each size offers up to 128K tokens of context; weights are on Hugging Face, and mini and medium were also hosted in Azure.",
    "sources": [
      {
        "id": "src.microsoft.phi-3-announcement"
      },
      {
        "id": "src.microsoft.phi-3-build-2024"
      },
      {
        "id": "src.microsoft.phi-3-mini-4k-instruct-model-card"
      }
    ]
  },
  "changes": [
    {
      "id": "sizes",
      "aspect": "size",
      "direction": "increased",
      "relativeTo": "microsoft.phi-2",
      "text": "Offered in three sizes, 3.8 billion (mini), 7 billion (small) and 14 billion (medium) parameters, against 2.7 billion for Phi-2.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-build-2024"
        },
        {
          "id": "src.microsoft.phi-2-model-card"
        }
      ]
    },
    {
      "id": "context-window",
      "aspect": "context-length",
      "direction": "increased",
      "relativeTo": "microsoft.phi-2",
      "text": "Context window of up to 128K tokens, compared with 2,048 tokens for Phi-2; each size also has a short-context version.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-announcement"
        },
        {
          "id": "src.microsoft.phi-3-build-2024"
        },
        {
          "id": "src.microsoft.phi-2-model-card"
        }
      ]
    },
    {
      "id": "instruction-tuned",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "microsoft.phi-2",
      "text": "Released as instruction-tuned models, post-trained with supervised fine-tuning and direct preference optimization; Phi-2 was a base model.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-mini-4k-instruct-model-card"
        },
        {
          "id": "src.microsoft.phi-2-blog"
        }
      ]
    },
    {
      "id": "training-data",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "microsoft.phi-2",
      "text": "Trained on a scaled-up version of the phi-2 data, made of heavily filtered public web data and synthetic data; phi-3-mini saw 3.3 trillion tokens.",
      "sources": [
        {
          "id": "src.microsoft.phi-3-technical-report"
        }
      ]
    }
