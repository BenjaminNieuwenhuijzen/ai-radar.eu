  "summary": {
    "text": "Phi-4-mini-flash-reasoning is a 3.8-billion-parameter open model from Microsoft for math reasoning with a 64K-token context, released on 9 July 2025 on Azure AI Foundry, the NVIDIA API Catalog and Hugging Face. It uses the SambaY decoder-hybrid-decoder architecture, which combines Mamba state space layers, sliding window attention and Gated Memory Units, and targets edge and mobile use.",
    "sources": [
      {
        "id": "src.microsoft.phi-4-mini-flash-reasoning-announcement"
      },
      {
        "id": "src.microsoft.phi-4-mini-flash-reasoning-model-card"
      }
    ]
  },
  "changes": [
    {
      "id": "sambay",
      "aspect": "architecture",
      "direction": "changed",
      "relativeTo": "microsoft.phi-4-mini-reasoning",
      "text": "Replaces the dense Transformer with the SambaY decoder-hybrid-decoder architecture, which uses Gated Memory Units.",
      "sources": [
        {
          "id": "src.microsoft.phi-4-mini-flash-reasoning-announcement",
          "locator": "Efficiency without compromise"
        }
      ]
    },
    {
      "id": "throughput",
      "aspect": "efficiency",
      "direction": "changed",
      "relativeTo": "microsoft.phi-4-mini-reasoning",
      "text": "Microsoft says it decodes with higher throughput and lower latency than Phi-4-mini-reasoning, especially on long generations.",
      "sources": [
        {
          "id": "src.microsoft.phi-4-mini-flash-reasoning-announcement"
        }
      ]
    },
    {
