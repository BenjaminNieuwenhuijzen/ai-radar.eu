  "summary": {
    "text": "Phi-4-reasoning is a 14-billion-parameter open-weight reasoning model from Microsoft, created by supervised fine-tuning of Phi-4 and released on 30 April 2025 on Azure AI Foundry and Hugging Face under the MIT licence. Its answers contain a chain-of-thought section followed by a summary; the Phi-4-reasoning-plus variant adds a short reinforcement learning phase.",
    "sources": [
      {
        "id": "src.microsoft.phi-4-reasoning-announcement"
      },
      {
        "id": "src.microsoft.phi-4-reasoning-model-card"
      },
      {
        "id": "src.microsoft.phi-4-reasoning-technical-report"
      }
    ]
  },
