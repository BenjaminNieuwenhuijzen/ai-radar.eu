  "summary": {
    "text": "Phi-mini-MoE is an open-weights mixture-of-experts language model from Microsoft with 7.6 billion total and 2.4 billion active parameters, compressed from Phi-3.5-MoE with the SlimMoE method and published on Hugging Face in June 2025 under the MIT licence. It handles English text with a 4k-token context; the smaller Phi-tiny-MoE was released with it.",
    "sources": [
      {
        "id": "src.microsoft.slimmoe-paper"
      },
      {
        "id": "src.microsoft.phi-mini-moe-instruct-model-card"
      }
