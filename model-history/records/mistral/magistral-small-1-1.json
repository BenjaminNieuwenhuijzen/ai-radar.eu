  "summary": {
    "text": "Magistral Small 1.1 is an update of Magistral Small 1.0, Mistral AI's 24B-parameter reasoning model, released on 24 July 2025 as open weights under Apache 2.0 and as API model magistral-small-2507. The model card describes changes to tone, formatting and reasoning markup, and says performance is about the same as version 1.0.",
    "sources": [
      {
        "id": "src.mistral.hf-magistral-small-2507"
      },
      {
        "id": "src.mistral.changelog",
        "locator": "July 24, 2025"
      }
    ]
  },
