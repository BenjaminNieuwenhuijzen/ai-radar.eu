    {
      "id": "tone-formatting",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "mistral.magistral-small",
      "text": "Better tone and behaviour, with improved LaTeX and Markdown formatting and shorter answers to easy prompts.",
      "sources": [
        {
          "id": "src.mistral.hf-magistral-small-2507"
        }
      ]
    },
    {
      "id": "generation-loops",
      "aspect": "other",
      "direction": "changed",
      "relativeTo": "mistral.magistral-small",
      "text": "Less likely to enter infinite generation loops.",
      "sources": [
        {
          "id": "src.mistral.hf-magistral-small-2507"
        }
      ]
    },
    {
      "id": "think-tokens",
      "aspect": "reasoning",
      "direction": "changed",
      "relativeTo": "mistral.magistral-small",
      "text": "Special [THINK] and [/THINK] tokens wrap the reasoning trace, and the reasoning prompt moved into the system prompt.",
      "sources": [
        {
          "id": "src.mistral.hf-magistral-small-2507"
        }
      ]
    }
  ],
