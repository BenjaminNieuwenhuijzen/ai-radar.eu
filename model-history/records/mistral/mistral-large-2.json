  "summary": {
    "text": "Mistral Large 2 is the second generation of Mistral AI's Mistral Large language model, with 123 billion parameters and a 128k-token context window. It was offered on la Plateforme as mistral-large-2407, in le Chat and through cloud providers, and its instruct weights were published under the Mistral Research License for research and non-commercial use.",
    "sources": [
      {
        "id": "src.mistral.mistral-large-2-announcement"
      },
      {
        "id": "src.mistral.hf-mistral-large-instruct-2407"
      }
    ]
  },
