  "summary": {
    "text": "Mistral Large 3 is a sparse mixture-of-experts language model from Mistral AI with 675B total and 41B active parameters, released on 2 December 2025 with the Ministral 3 series as part of Mistral 3. It accepts text and images, has a 256k-token context window and is offered on Mistral's API, through cloud partners and as Apache 2.0 base and instruct weights.",
    "sources": [
      {
        "id": "src.mistral.mistral-3-announcement"
