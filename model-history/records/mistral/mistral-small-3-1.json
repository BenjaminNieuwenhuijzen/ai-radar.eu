  "summary": {
    "text": "Mistral Small 3.1 is a 24B-parameter model from Mistral AI that builds on Mistral Small 3, adding image understanding and a context window of up to 128k tokens. It was released with base and instruct open weights under Apache 2.0 and offered via API on La Plateforme and Google Cloud Vertex AI.",
    "sources": [
      {
        "id": "src.mistral.mistral-small-3-1-announcement"
      },
      {
        "id": "src.mistral.hf-mistral-small-3-1-24b-instruct-2503"
      }
    ]
  },
