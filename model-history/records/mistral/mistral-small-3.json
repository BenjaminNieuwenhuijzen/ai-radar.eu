  "summary": {
    "text": "Mistral Small 3 is a 24B-parameter language model from Mistral AI, released with pretrained and instruction-tuned open weights under Apache 2.0 and offered via API on la Plateforme and through partners. Mistral AI describes it as latency-optimised, with far fewer layers than competing models, and says it was trained without reinforcement learning or synthetic data.",
    "sources": [
      {
        "id": "src.mistral.mistral-small-3-announcement"
      },
      {
        "id": "src.mistral.hf-mistral-small-24b-instruct-2501"
      }
    ]
  },
