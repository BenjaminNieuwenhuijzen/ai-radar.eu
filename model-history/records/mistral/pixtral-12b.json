  "summary": {
    "text": "Pixtral 12B is a multimodal model from Mistral AI that takes images and text and outputs text, combining a new 400M-parameter vision encoder with a 12B decoder based on Mistral Nemo. It was released under Apache 2.0 and offered on la Plateforme as pixtral-12b-2409 and in le Chat, and processes images at their native resolution within a 128k-token context window.",
    "sources": [
      {
        "id": "src.mistral.pixtral-12b-announcement"
      },
      {
        "id": "src.mistral.pixtral-12b-paper"
      },
