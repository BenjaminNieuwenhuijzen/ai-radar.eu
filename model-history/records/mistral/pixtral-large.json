  "summary": {
    "text": "Pixtral Large is a 124B multimodal model from Mistral AI that takes text and images and outputs text, built on Mistral Large 2 with a 123B decoder and a 1B-parameter vision encoder. Mistral calls it the second model in its multimodal family; it was offered in le Chat, on the API and as weights under the Mistral Research License, with a commercial licence for commercial use.",
    "sources": [
      {
        "id": "src.mistral.pixtral-large-announcement"
      },
      {
        "id": "src.mistral.docs-pixtral-large-24-11",
        "locator": "Modalities"
      },
      {
        "id": "src.mistral.hf-pixtral-large-instruct-2411"
      }
    ]
  },
