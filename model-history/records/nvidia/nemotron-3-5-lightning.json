  "summary": {
    "text": "Nemotron 3.5 Lightning is an open-weights reasoning language model with 30B total and 3B active parameters that NVIDIA added to the Nemotron 3 family after Nemotron 3 Nano. NVIDIA aims it at high-volume agent work such as tool calls and subagent delegation, and released it with the NeMo Switchyard routing library, as a download and on build.nvidia.com.",
    "sources": [
      {
        "id": "src.nvidia.nemotron-3-5-lightning-blog"
      },
      {
        "id": "src.nvidia.nemotron-3-5-lightning-developer-blog"
      }
    ]
  },
