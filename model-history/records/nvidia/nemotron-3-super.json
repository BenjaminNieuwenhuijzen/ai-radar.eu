  "summary": {
    "text": "Nemotron 3 Super is an open-weights reasoning language model in NVIDIA's Nemotron 3 family, with 120B total and 12B active parameters, a hybrid Mamba-Transformer mixture-of-experts design and a context window of up to 1M tokens. NVIDIA designed it for agentic systems and offered it as a download, on build.nvidia.com and through cloud partners.",
    "sources": [
      {
        "id": "src.nvidia.nemotron-3-super-blog"
      },
      {
        "id": "src.nvidia.nemotron-3-super-120b-a12b-bf16-model-card",
        "locator": "Model Summary"
      }
    ]
  },
