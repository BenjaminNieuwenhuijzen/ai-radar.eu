  "summary": {
    "text": "Nemotron 3 Ultra is an open-weights reasoning language model and the Ultra size of NVIDIA's Nemotron 3 family, with 550B total and 55B active parameters and a context length of up to 1M tokens. NVIDIA built it for long-running agents with contributions from the Nemotron Coalition and offered it as a download, on build.nvidia.com and through partners.",
    "sources": [
      {
        "id": "src.nvidia.gtc-taipei-computex-2026-live-blog",
        "locator": "Thursday, June 4, 6:00 a.m. PT"
      },
      {
        "id": "src.nvidia.nemotron-3-ultra-550b-a55b-bf16-model-card",
        "locator": "Model Summary"
      },
      {
        "id": "src.nvidia.nemotron-3-ultra-research-page"
      }
    ]
  },
