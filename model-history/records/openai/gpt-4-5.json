  "summary": {
    "text": "GPT-4.5 is a language model in OpenAI's GPT line for text and image input, released on 27 February 2025 as a research preview in ChatGPT and the API. OpenAI presented it as a step in scaling pre-training rather than reasoning; it was shut down in the API on 14 July 2025, with GPT-4.1 as the recommended replacement.",
    "sources": [
      {
        "id": "src.openai.gpt-4-5-announcement"
      },
      {
        "id": "src.openai.gpt-4-5-system-card"
      },
