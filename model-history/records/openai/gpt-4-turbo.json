  "summary": {
    "text": "GPT-4 Turbo is an OpenAI model for the API, announced at DevDay on 6 November 2023 as a preview of the next generation of GPT-4 and offered that day as gpt-4-1106-preview. It has a 128K context window and lower prices than GPT-4; image input moved into the main model at general availability on 9 April 2024.",
    "sources": [
      {
        "id": "src.openai.devday-2023-announcement"
      },
      {
        "id": "src.openai.api-changelog"
      }
    ]
  },
  "changes": [
    {
      "id": "context-window",
      "aspect": "context-length",
      "direction": "increased",
      "relativeTo": "openai.gpt-4",
      "text": "Context window of 128K tokens, which OpenAI says fits more than 300 pages of text; the gpt-4 API model had 8,192 tokens.",
      "sources": [
        {
          "id": "src.openai.devday-2023-announcement"
        },
        {
          "id": "src.openai.gpt-4-research"
        }
      ]
    },
    {
      "id": "knowledge-cutoff",
      "aspect": "training-data",
      "direction": "changed",
      "relativeTo": "openai.gpt-4",
      "text": "Knowledge of world events extends to April 2023.",
      "sources": [
        {
          "id": "src.openai.devday-2023-announcement"
        }
      ]
    },
    {
      "id": "price",
      "aspect": "efficiency",
      "relativeTo": "openai.gpt-4",
      "text": "OpenAI priced it three times lower for input tokens and two times lower for output tokens than GPT-4.",
      "sources": [
        {
          "id": "src.openai.devday-2023-announcement"
        }
      ]
    },
    {
