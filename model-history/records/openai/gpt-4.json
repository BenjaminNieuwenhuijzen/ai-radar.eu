  "summary": {
    "text": "GPT-4 is an OpenAI model that OpenAI describes as a large multimodal model taking image and text input and producing text. It was released on 14 March 2023 in ChatGPT Plus and through an API waitlist, with image input following later, and its technical report withholds details on architecture, model size, training compute and data.",
    "sources": [
      {
        "id": "src.openai.gpt-4-research"
      },
      {
        "id": "src.openai.gpt-4-technical-report"
      },
      {
        "id": "src.openai.gpt-4v-system-card"
      }
    ]
  },
