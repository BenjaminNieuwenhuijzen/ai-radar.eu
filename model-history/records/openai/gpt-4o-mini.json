  "summary": {
    "text": "GPT-4o mini is a small, low-cost OpenAI model released on 18 July 2024 in the API and in ChatGPT, where it took the place of GPT-3.5. It accepts text and image input with a 128K context window, and OpenAI says it is the first model to apply its instruction hierarchy method against jailbreaks and prompt injections.",
    "sources": [
      {
        "id": "src.openai.gpt-4o-mini-announcement"
      }
    ]
  },
  "changes": [
    {
      "id": "image-input",
      "aspect": "modality",
