    },
    {
      "id": "context-window",
      "aspect": "context-length",
      "direction": "increased",
      "relativeTo": "openai.gpt-3-5-turbo",
      "text": "Context window of 128,000 tokens with up to 16,384 output tokens, up from 16,385 tokens for gpt-3.5-turbo-0125.",
      "sources": [
        {
          "id": "src.openai.gpt-4o-mini-docs"
        },
        {
          "id": "src.openai.gpt-3-5-turbo-docs"
        }
      ]
    },
    {
      "id": "price",
      "aspect": "efficiency",
      "relativeTo": "openai.gpt-3-5-turbo",
      "text": "Priced at 15 cents per million input tokens and 60 cents per million output tokens, which OpenAI says is more than 60 percent below GPT-3.5 Turbo.",
      "sources": [
        {
          "id": "src.openai.gpt-4o-mini-announcement"
        }
      ]
    },
    {
      "id": "instruction-hierarchy",
      "aspect": "safety",
      "direction": "added",
      "relativeTo": "openai.gpt-3-5-turbo",
      "text": "OpenAI says it is the first model to apply its instruction hierarchy method, meant to resist jailbreaks, prompt injections and system prompt extraction.",
      "sources": [
        {
          "id": "src.openai.gpt-4o-mini-announcement"
        }
      ]
    }
