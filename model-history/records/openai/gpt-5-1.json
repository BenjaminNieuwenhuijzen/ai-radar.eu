    ]
  },
  "changes": [
    {
      "id": "adaptive-reasoning",
      "aspect": "reasoning",
      "direction": "changed",
      "relativeTo": "openai.gpt-5",
      "text": "OpenAI says thinking time adapts more closely to task difficulty, and GPT-5.1 Instant is the first Instant model that can decide to think before answering.",
      "sources": [
