  "summary": {
    "text": "GPT-5.3 Instant is an update to the Instant model in OpenAI's ChatGPT for text and image input, released on 3 March 2026 to all ChatGPT users and in the API as gpt-5.3-chat-latest. OpenAI says it refuses less often without need and adds fewer defensive preambles. No GPT-5.3 Thinking model was released.",
    "sources": [
      {
        "id": "src.openai.gpt-5-3-instant"
      },
      {
        "id": "src.openai.api-model-gpt-5-3-chat-latest",
        "locator": "Model details"
      },
      {
        "id": "src.openai.gpt-5-4-thinking-system-card",
        "locator": "Introduction"
      }
    ]
  },
