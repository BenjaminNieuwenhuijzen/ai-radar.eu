  "summary": {
    "text": "o3 is a reasoning model in OpenAI's o-series for text and image input, previewed in December 2024 and released with o4-mini on 16 April 2025 in ChatGPT and the API. OpenAI says o3 and o4-mini were its first reasoning models able to use and combine every ChatGPT tool on their own, and that they can work with images within their chain of thought.",
    "sources": [
      {
        "id": "src.openai.o3-o4-mini-announcement"
      },
      {
        "id": "src.openai.12-days-day-12-livestream"
      },
      {
        "id": "src.openai.o3-docs"
      }
    ]
  },
